externals:
    Libs/LibSpecialization: https://github.com/BigWigsMods/LibSpecialization.git/LibSpecialization
    libs/LibStub: 
        url: svn://svn.wowace.com/wow/libstub/mainline/trunk
        tag: latest

# Files starting with a dot are left out by the packager already.
ignore:
  - settings.json
  - annotations
  - coverage
  - tests
  - tasks
  - chattynatorspecialisationicons-dev-1.rockspec
  - stylua.toml